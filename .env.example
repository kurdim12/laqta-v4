# LAQTA v3 — client environment
#
# This file holds ONLY public values. The service-role key and every provider key
# (OpenRouter, Anam, and any future one) live exclusively in Supabase secrets and are read
# by the Edge Function at runtime. They are never in this repository, never in a build, and
# never pasted into chat.
#
# Copy to .env and fill in. .env is gitignored.

VITE_SUPABASE_URL=https://bdzdvlnmocojsifdkpvd.supabase.co
VITE_API_URL=https://bdzdvlnmocojsifdkpvd.supabase.co/functions/v1/api

# The anon key is designed to be public and ships in the browser. As of migration 0008 it can
# execute nothing at all against the database — every surface goes through the API layer — so
# it is carried here only for completeness.
VITE_SUPABASE_ANON_KEY=
